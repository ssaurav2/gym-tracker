# Copy to .env locally. Never commit .env or paste its contents in chat.
# Backend only. Use incline_api.PROJECT_REF on the shared transaction pooler, port 6543.
DATABASE_URL=REPLACE_WITH_RESTRICTED_TRANSACTION_POOLER_URL
SUPABASE_URL=REPLACE_WITH_HTTPS_PROJECT_ORIGIN
SUPABASE_JWT_ALGORITHM=REPLACE_WITH_ES256_RS256_OR_HS256
# Public key, needed for legacy verification and optional dev-project login tests.
SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_PUBLISHABLE_KEY
# Dev integration tests only. Two existing dashboard-created dev accounts.
TEST_USER_A_EMAIL=REPLACE_WITH_DEV_USER_A_EMAIL
TEST_USER_A_PASSWORD=REPLACE_WITH_DEV_USER_A_PASSWORD
TEST_USER_B_EMAIL=REPLACE_WITH_DEV_USER_B_EMAIL
TEST_USER_B_PASSWORD=REPLACE_WITH_DEV_USER_B_PASSWORD
