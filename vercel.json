{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "functions": {
    "api.py": {
      "maxDuration": 30,
      "excludeFiles": "{**/*.db*,**/*.sqlite*,backups/**,private/**,**/.env*,.venv/**,frontend/**,design/**,supabase/**,test_*.py,import_sqlite.py,app.py,run_local.py}"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Vercel-CDN-Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
